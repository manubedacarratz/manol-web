---
interface Props {
  href?: string;
  marginBottom?: string;
}
const { href, marginBottom = '-40px' } = Astro.props;
---

<div id="gif-footer-wrapper" style={`margin-bottom: ${marginBottom};`}>
  {href ? (
    <a href={href} style="display: block; cursor: none;">
      <img
        id="gif-footer"
        src="/footer/manol.gif"
        alt="MANOL"
        class="reveal"
        style="width: 98%; height: auto; display: block; margin: 0 auto; --reveal-opacity: 0.4; --i: 0;"
      />
    </a>
  ) : (
    <img
      id="gif-footer"
      src="/footer/manol.gif"
      alt="MANOL"
      class="reveal"
      style="width: 98%; height: auto; display: block; margin: 0 auto; cursor: none; --reveal-opacity: 0.4; --i: 0;"
    />
  )}
</div>

<style>
  #gif-footer-wrapper {
    margin-left: -50px;
    margin-right: -50px;
  }

  @media (max-width: 767px) {
    #gif-footer-wrapper {
      margin-left: -12px;
      margin-right: -12px;
    }
  }
</style>
